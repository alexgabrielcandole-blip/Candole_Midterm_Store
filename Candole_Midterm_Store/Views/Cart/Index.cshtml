@model IEnumerable<CartItem>

@{
    ViewData["Title"] = "Cart";
    var total = Model.Sum(i => i.Price * i.Quantity);
}

<h1 class="h3 mb-4">Your Cart</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Your cart is empty. <a asp-controller="Products" asp-action="Index">Browse products</a>.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product Name</th>
                        <th class="text-end">Price</th>
                        <th style="width: 220px;">Quantity</th>
                        <th class="text-end">Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td class="text-end">@($"₱{item.Price:N2}")</td>
                            <td>
                                <form asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="999"
                                           class="form-control form-control-sm" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Update</button>
                                </form>
                            </td>
                            <td class="text-end">@($"₱{item.Price * item.Quantity:N2}")</td>
                            <td class="text-end">
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <th colspan="3" class="text-end fs-5">Total</th>
                        <th class="text-end fs-5">@($"₱{total:N2}")</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary mt-3">Continue Shopping</a>
}