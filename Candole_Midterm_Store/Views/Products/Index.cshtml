@model IEnumerable<Product>

@{
    ViewData["Title"] = "Products";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Products</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add Product</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-sm-8 col-md-6">
        <input type="text" name="search" value="@search" class="form-control"
               placeholder="Search product by name..." />
    </div>
    <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-dark">Search</button>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    if (!string.IsNullOrWhiteSpace(search))
    {
        <div class="alert alert-warning">No products found matching "@search".</div>
    }
    else
    {
        <div class="alert alert-info">No products yet. Click "Add Product" to create your first one.</div>
    }
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@p.Category</span>
                        <h5 class="card-title">@p.Name</h5>
                        <p class="card-text text-muted">@p.Description</p>
                        <p class="fs-5 fw-semibold mb-0">@($"₱{p.Price:N2}")</p>
                    </div>
                    <div class="card-footer bg-white d-flex gap-2">
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <button type="submit" class="btn btn-success btn-sm">Add to Cart</button>
                        </form>
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-outline-danger btn-sm"
                           onclick="return confirm('Delete this product?');">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}